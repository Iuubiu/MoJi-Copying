# 工具/编辑器
.workbuddy/
.vscode/
.idea/
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Node / 前端构建产物（dist/ 由 npm run build 生成，不入库）
node_modules/
dist/

# 便携版打包目录（由 scripts/build-portable.cmd 生成，不入库）
dist-portable/

# Rust / Tauri 构建产物
src-tauri/target/
src-tauri/gen/

# 本地数据文件（数据库只属于用户本机，绝不进仓库）
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# 回归检查的临时输出
verify/_out-*.json
verify/_err-*.txt
verify/_tmp-*.js
