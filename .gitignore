# 工具/编辑器
.workbuddy/
.vscode/
.idea/
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 构建产物（发布包由 desktop/make_release.py 生成，不入库）
outputs/
desktop/build/
desktop/dist/

# 本地数据文件（数据库只属于用户本机，绝不进仓库）
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
desktop/selftest*.json

# 回归检查的临时输出
verify/_out-*.json
verify/_err-*.txt
verify/_tmp-*.js
